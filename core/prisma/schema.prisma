datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "linux-musl-openssl-3.0.x"]
}

enum Role {
  L1_OBSERVER
  L2_OPERATOR
  L3_ADMIN
}

enum EquipmentType {
  PFSENSE
  MIKROTIK
  LINUX_SERVER
  WINDOWS_SERVER
  PROXMOX
  ZABBIX
  GENERIC_SNMP
}

enum IncidentSeverity {
  INFO
  WARNING
  CRITICAL
}

enum IncidentStatus {
  OPEN
  INVESTIGATING
  RESOLVED
}

enum ApprovalStatus {
  PENDING
  APPROVED
  EXPIRED
  REJECTED
}

enum UserRole {
  SUPERADMIN     // Acesso global irrestrito, gerencia tenants e sistema
  TENANT_MASTER  // Gerente do tenant, cadastra usuários para o seu próprio tenant
  OPERATOR       // Operador de rede do tenant (diagnósticos, chamados)
  VIEWER         // Somente leitura do tenant
}

enum TenantStatus {
  ACTIVE
  SUSPENDED
  TRIAL
}

model Tenant {
  id          String       @id @default(uuid())
  name        String       // Ex: "SuperTop Supermercados"
  slug        String       @unique // Ex: "supertop"
  document    String?      // CNPJ / CPF
  status      TenantStatus @default(ACTIVE)
  plan        String?      @default("ENTERPRISE")
  // Gestão de Cotas e Governança do Plano
  maxEquipments Int?       @default(10) // 0 = Ilimitado
  maxUsers      Int?       @default(3)  // 0 = Ilimitado
  maxStorages   Int?       @default(1)  // 0 = Ilimitado
  aiLevel       String?    @default("L1_READ") // L1_READ, L2_REMEDIATION, L3_CRITICAL
  retentionDays Int?       @default(30)
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  users        User[]
  equipments   Equipment[]
  storages     Storage[]
  featureFlags FeatureFlag[]

  @@map("tenants")
}

model User {
  id           String    @id @default(uuid())
  tenantId     String?
  tenant       Tenant?   @relation(fields: [tenantId], references: [id], onDelete: SetNull)
  name         String
  email        String    @unique
  passwordHash String
  salt         String
  role         UserRole  @default(OPERATOR)
  phone        String?
  totpSecret   String?   // Segredo Base32 para 2FA
  totpEnabled  Boolean   @default(false)
  active       Boolean   @default(true)
  lastLoginAt  DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  @@index([tenantId])
  @@index([email])
  @@map("users")
}

model Operator {
  id               String            @id @default(uuid())
  name             String
  phone            String            @unique // Número WhatsApp formatado (ex: 5511999999999)
  email            String?           @unique
  role             Role              @default(L1_OBSERVER)
  active           Boolean           @default(true)
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt
  auditLogs        AuditLog[]
  approvalRequests ApprovalRequest[]

  @@map("operators")
}

enum StorageType {
  S3_COMPATIBLE   // MinIO, AWS S3, Wasabi, Cloudflare R2, Backblaze B2
  SFTP            // Servidor Linux / NAS via SFTP
  LOCAL_NFS       // Diretório montado / NFS
}

model Storage {
  id                   String        @id @default(uuid())
  name                 String        // Ex: "MinIO Local", "Wasabi Offsite", "NAS Matriz"
  type                 StorageType   @default(S3_COMPATIBLE)
  endpoint             String        // Ex: "https://minio.awecloudsolution.com" ou "sftp.empresa.com"
  bucketOrPath         String        // Ex: "nocagent-backups" ou "/var/backups"
  region               String?       @default("us-east-1")
  // Cofre Criptográfico AES-256-GCM para credenciais do Storage
  encryptedCredentials String
  iv                   String
  authTag              String
  isDefault            Boolean       @default(false)
  active               Boolean       @default(true)
  createdAt            DateTime      @default(now())
  updatedAt            DateTime      @updatedAt

  // Vínculo Multi-Tenant
  tenantId             String?
  tenant               Tenant?       @relation(fields: [tenantId], references: [id], onDelete: SetNull)

  equipments           Equipment[]
  backupAudits         BackupAudit[]

  @@index([tenantId])
  @@map("storages")
}

model Equipment {
  id                   String        @id @default(uuid())
  name                 String
  type                 EquipmentType
  host                 String        // URL ou IP (ex: https://pfsense.seudominio.com.br:8181)
  port                 Int?
  // Cofre Criptográfico AES-256-GCM
  encryptedCredentials String        // JSON cifrado com tokens, senhas ou API keys
  iv                   String        // Initialization Vector (12 bytes hex)
  authTag              String        // GCM Authentication Tag (16 bytes hex)
  status               String        @default("unknown") // online, degraded, offline, unknown
  lastLatency          Float?
  lastLossPercent      Float?
  lastCheck            DateTime?
  active               Boolean       @default(true)
  // Modo de conexão e Agente de Host Outbound (Linux & Windows)
  connectionMode       String?       @default("DIRECT") // DIRECT (API/SSH/WinRM) ou AGENT (Outbound)
  enrollmentToken      String?       @unique
  enrollmentExpiresAt  DateTime?
  agentToken           String?       // Token persistente após auto-registro
  agentVersion         String?
  osInfo               Json?         // Informações de SO, CPU, RAM, Disco e Uptime reportadas pelo agente

  // Vínculo Multi-Tenant
  tenantId             String?
  tenant               Tenant?       @relation(fields: [tenantId], references: [id], onDelete: SetNull)
  // Vínculo com Storage de Destino para Backups
  backupStorageId      String?
  backupStorage        Storage?      @relation(fields: [backupStorageId], references: [id], onDelete: SetNull)
  backupSchedule       String?       @default("DAILY") // Periodicidade: HOURLY, DAILY, WEEKLY
  // Agrupamento Hierárquico Multi-Tenant (Cliente / Unidade / Tags)
  group                String?       @default("Geral") // Cliente / Tenant / Grupo principal (ex: "SuperTop", "Matriz")
  subgroup             String?       // Unidade / Filial / Subgrupo (ex: "Loja 01 - Centro", "CD Distribuição", "Mikrotiks")
  tags                 String[]      @default([])      // Tags funcionais livres (ex: ["borda", "pdv", "telecom"])

  createdAt            DateTime      @default(now())
  updatedAt            DateTime      @updatedAt
  incidents            Incident[]
  backupAudits         BackupAudit[]
  mcpTraces            McpTrace[]

  @@index([tenantId])
  @@index([group])
  @@index([subgroup])
  @@map("equipments")
}

model AuditLog {
  id         String    @id @default(uuid())
  operatorId String?
  operator   Operator? @relation(fields: [operatorId], references: [id], onDelete: SetNull)
  action     String    // Ex: "CONSULTAR_GATEWAY", "REINICIAR_VM", "AUDITORIA_BACKUP"
  target     String?   // Ex: "pfSense Matriz", "VM 105"
  status     String    // SUCCESS, DENIED, FAILED, TIMEOUT
  source     String    @default("WHATSAPP") // WHATSAPP, WEB_DASHBOARD, CRON, SYSTEM
  details    Json?     // Metadados técnicos da execução
  createdAt  DateTime  @default(now())

  @@index([createdAt])
  @@index([action])
  @@map("audit_logs")
}

model Incident {
  id          String           @id @default(uuid())
  equipmentId String?
  equipment   Equipment?       @relation(fields: [equipmentId], references: [id], onDelete: SetNull)
  title       String           // Ex: "Gateway WANGW com 100% de perda"
  severity    IncidentSeverity @default(WARNING)
  status      IncidentStatus   @default(OPEN)
  description String
  rootCause   String?
  detectedAt  DateTime         @default(now())
  resolvedAt  DateTime?
  metadata    Json?

  @@index([status])
  @@index([detectedAt])
  @@map("incidents")
}

model BackupAudit {
  id            String     @id @default(uuid())
  equipmentId   String?
  equipment     Equipment? @relation(fields: [equipmentId], references: [id], onDelete: SetNull)
  storageId     String?
  storage       Storage?   @relation(fields: [storageId], references: [id], onDelete: SetNull)
  storageBucket String     @default("nocagent")
  backupFile    String     // Nome do arquivo ou caminho no Storage
  sizeBytes     BigInt?    // Tamanho do arquivo em bytes
  status        String     // SUCCESS, FAILED, MISSING
  notes         String?
  verifiedAt    DateTime   @default(now())

  @@index([verifiedAt])
  @@index([status])
  @@map("backup_audits")
}

model ApprovalRequest {
  id         String         @id @default(uuid())
  code       String         @unique // Código temporário de 4 dígitos (ex: "4821")
  action     String         // Ex: "REINICIAR_VM"
  target     String         // Ex: "VM 105 no Proxmox"
  payload    Json           // Parâmetros a executar quando aprovado
  operatorId String?
  operator   Operator?      @relation(fields: [operatorId], references: [id], onDelete: SetNull)
  status     ApprovalStatus @default(PENDING)
  expiresAt  DateTime
  createdAt  DateTime       @default(now())

  @@index([code])
  @@index([status])
  @@map("approval_requests")
}

model FeatureFlag {
  id          String   @id @default(uuid())
  key         String   // Ex: "ai-autonomous-l1-read", "ai-autonomous-l2-remediation", "ai-autonomous-l3-critical"
  description String?
  type        String   @default("BOOLEAN") // BOOLEAN, PERCENTAGE, TENANT_LIST
  value       String   @default("true")
  tenantId    String?
  tenant      Tenant?  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  enabled     Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([key, tenantId])
  @@index([key])
  @@map("feature_flags")
}

model McpTrace {
  id          String     @id @default(uuid())
  driver      String     // PROXMOX, MIKROTIK, PFSENSE, ZABBIX, LLM
  equipmentId String?
  equipment   Equipment? @relation(fields: [equipmentId], references: [id], onDelete: SetNull)
  method      String     // GET, POST, PING, etc.
  endpoint    String     // Ex: "/api2/json/nodes/pve/status" ou "RouterOS:ping"
  durationMs  Float      // Latência em milissegundos
  statusCode  Int?       // Código HTTP (ex: 200, 500) ou status code
  error       String?
  createdAt   DateTime   @default(now())

  @@index([driver])
  @@index([createdAt])
  @@map("mcp_traces")
}

model SystemMetric {
  id            String   @id @default(uuid())
  service       String   // core, web
  cpuPercent    Float
  memoryBytes   BigInt
  activeSockets Int?
  timestamp     DateTime @default(now())

  @@index([service])
  @@index([timestamp])
  @@map("system_metrics")
}

