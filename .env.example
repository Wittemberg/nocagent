# ==============================================================================
# NOC-AGENT • CONFIGURAÇÃO DE AMBIENTE (.env.example)
# ==============================================================================

# --- AMBIENTE GERAL ---
NODE_ENV=production
PORT=3000

# --- 1. PROVEDORES DE IA (LLM) ---
# Chave da Anthropic para Claude 3.5 Sonnet / Haiku
ANTHROPIC_API_KEY=sk-ant-api03-...
# Chave da OpenAI para GPT-4o / Fallback
OPENAI_API_KEY=sk-proj-...

# --- 2. BANCO DE DADOS POSTGRESQL ---
POSTGRES_USER=nocagent
POSTGRES_PASSWORD=sua_senha_segura_postgres
POSTGRES_DB=nocagent
DATABASE_URL=postgresql://nocagent:sua_senha_segura_postgres@postgres:5432/nocagent?schema=public

# --- 3. FILAS & CACHE REDIS ---
REDIS_URL=redis://redis:6379/0
REDIS_KEY_PREFIX=nocagent:

# --- 4. STORAGE S3 (BACKUPS, SNAPSHOTS E LOGS) ---
S3_ENDPOINT=https://storage.awecloudsolution.com
S3_REGION=us-east-1
S3_ACCESS_KEY=seu_access_key_s3
S3_SECRET_KEY=sua_secret_key_s3
S3_BUCKET=nocagent
S3_PUBLIC_URL=https://storage.awecloudsolution.com/nocagent

# --- 5. COFRE CRIPTOGRÁFICO DE CREDENCIAIS (AES-256-GCM) ---
# Chave de 32 bytes (64 caracteres hexadecimais) para cifrar tokens de equipamentos
# Gere com: openssl rand -hex 32
VAULT_MASTER_KEY=coloque_aqui_64_caracteres_hexadecimais_para_chave_aes256

# --- 6. DCC (DEVELOPER CONTROL CHANNEL & 2FA) ---
DCC_ENABLED=true
DCC_DEVELOPER_USERNAME=superadmin
# Segredo Base32 para 2FA via Google Authenticator / Authy
# Gere com: openssl rand -base32 16
DCC_TOTP_SECRET=JBSWY3DPEHPK3PXP

# --- 7. CHATWOOT DUAL-API BRIDGE (WHATSAPP) ---
CHATWOOT_BASE_URL=https://chatwoot.awecloudsolution.com
CHATWOOT_ACCOUNT_ID=1
# Token de Acesso da Conta (Settings -> Account Settings -> API Access Tokens)
CHATWOOT_ACCOUNT_API_KEY=seu_account_api_key_chatwoot
CHATWOOT_INBOX_ID=1
# Token da Caixa de Entrada / Bot do Inbox
CHATWOOT_INBOX_API_KEY=seu_inbox_api_key_chatwoot
# Segredo de validação do Webhook
CHATWOOT_WEBHOOK_SECRET=seu_webhook_secret_chatwoot

# --- 8. PFSENSE INTEGRATION ---
PFSENSE_BASE_URL=https://libra-vivo.awecloudsolution.com:8181
PFSENSE_API_KEY=sua_api_key_do_pfsense

# --- 9. ZABBIX MONITORING (OPCIONAL / FASE 2) ---
ZABBIX_API_URL=https://zabbix.awecloudsolution.com/api_jsonrpc.php
ZABBIX_API_TOKEN=seu_api_token_zabbix

# --- 10. PORTAINER STACK WEBHOOK (CI/CD DEPLOY AUTOMÁTICO) ---
# Webhook único gerado na Stack 'nocagent' dentro do Portainer
PORTAINER_STACK_WEBHOOK_URL=

